{
  "about": "implement already ran maxLoops (2) times",
  "expect": {
    "step": "implement",
    "stop": "visit-cap",
    "visits": {
      "checks": 2,
      "implement": 2,
      "plan": 1
    }
  },
  "flow": {
    "akit-flow-format": 1,
    "minPi": "1.0.4",
    "name": "feature",
    "steps": [
      {
        "agent": "planner",
        "bash": true,
        "gate": false,
        "id": "plan",
        "maxLoops": 3,
        "model": "m/a"
      },
      {
        "agent": "implementer",
        "bash": true,
        "gate": false,
        "id": "implement",
        "maxLoops": 2,
        "model": "m/a",
        "routes": {
          "failed:*": "plan"
        }
      },
      {
        "agent": "checker",
        "bash": true,
        "gate": false,
        "id": "checks",
        "maxLoops": 3,
        "model": "m/a",
        "routes": {
          "blocked:*": "plan",
          "failed:*": "implement"
        }
      },
      {
        "agent": "reviewer",
        "bash": true,
        "gate": false,
        "id": "review",
        "maxLoops": 3,
        "model": "m/b",
        "routes": {
          "done:*": "commit",
          "failed:*": "plan",
          "failed:notes": "implement"
        }
      },
      {
        "agent": "committer",
        "bash": true,
        "gate": false,
        "id": "commit",
        "maxLoops": 3,
        "model": "m/a",
        "routes": {
          "done:*": "end"
        }
      }
    ]
  },
  "outcome": "failed",
  "reason": "",
  "state": {
    "step": "checks",
    "visits": {
      "checks": 2,
      "implement": 2,
      "plan": 1
    }
  }
}
