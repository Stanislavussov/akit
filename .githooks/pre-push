#!/bin/sh
# Stop the push if the commits being pushed contain a secret (gitleaks).
# Catches commits made with --no-verify or before the hooks were installed.
# Skip once with: git push --no-verify
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not found, secret check skipped (brew install gitleaks)" >&2
  exit 0
fi
config="$(git rev-parse --show-toplevel)/.gitleaks.toml"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"     # new branch: only commits no remote has
  else
    range="$remote_sha..$local_sha"
  fi
  gitleaks git --redact -v --no-banner --log-level warn --config "$config" \
    --log-opts="$range" . || status=1
done
exit $status
